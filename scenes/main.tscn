[node name="HelpDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
title = "玩法说明"
position = Vector2i(0, 0)
size = Vector2i(440, 360)
ok_button_text = "知道了"
dialog_text = "🖱  左键      揭开格子 (0 自动展开空白)
🚩  右键 / M  插旗 (空白→红旗→问号)
⚡ 左右同时   数字格上: 连锁揭开周围剩余格
💡  提示 (H)  智能找安全格, 黄色高亮, 每局 3 次
🔄  重开 (R)  重新开始当前难度
🏆  最佳成绩  按难度自动保存, 破纪录有动效
🎚  自定义     行/列/雷数任意组合 (mines < rows×cols)

—— 雷的分布规则 ——
① 首次点击永不中雷 (3×3 安全区)
② 其余格子随机布雷 (Array.shuffle)
③ 数字 = 周围 8 格雷数
④ 胜利 = 揭开所有非雷格 (剩余自动插旗)
⑤ 失败 = 左键点中雷 (其他雷自动揭开, 错标红旗画 ✗)"